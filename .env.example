# ── Gemini ──────────────────────────────────────────────
GEMINI_API_KEY=your_api_key_here
# Live API modeli (native audio). Muqobil: gemini-3.8-live-extended-thinking, gemini-2.5-flash-native-audio-preview-09-2025
GEMINI_MODEL=gemini-3.8-live
# Matnli model (web_answer tool, Google Search grounding bilan)
GEMINI_TEXT_MODEL=gemini-3.8-flash
# low|medium|high — bo'sh = berilmaydi (extended-thinking modelida majburiy)
GEMINI_THINKING_LEVEL=
# Live sessiyada Google Search grounding (types.Tool(google_search=...))
# Live sessiyada Google Search grounding (ko'p kalitlarda kvotasiz -> 1011 xatosi). web_answer tooli baribir ishlaydi.
GOOGLE_SEARCH_GROUNDING=false
# Live API versiyasi (wss .../v1alpha.GenerativeService.BidiGenerateContent)
GEMINI_API_VERSION=v1alpha
GEMINI_VOICE=Aoede
ASSISTANT_LANGUAGE=uz

# ── Audio ───────────────────────────────────────────────
INPUT_SAMPLE_RATE=16000
OUTPUT_SAMPLE_RATE=24000
AUDIO_CHUNK_MS=20
# Mikrofon nomi yoki indeksi (bo'sh = tizim standarti)
INPUT_DEVICE=
PLAYBACK_ENABLED=true
VAD_THRESHOLD=0.02
# Yordamchi gapirayotganda mikrofonni bostirish (echo). Barge-in: RMS > bo'sag'a*ECHO_BARGE_FACTOR
ECHO_GUARD=true
ECHO_BARGE_FACTOR=3.0
# Barge-in faqat shuncha ms uzluksiz baland ovozdan keyin ochiladi (echo cho'qqisi javobni uzmasin)
ECHO_BARGE_MIN_MS=160
ECHO_BARGE_HOLD_MS=600
# Ijrodan oldingi jitter-bufer (ms); bufer navbat o'rtasida bo'shasa avtomatik kattalashadi
PLAYBACK_PREBUFFER_MS=220
# Chiqish oqimi latency'si: high (barqaror) | low | sekund
PLAYBACK_LATENCY=high

# ── Gemini server-VAD va transkripsiya ─────────────────
# LOW/HIGH. HIGH start — yordamchi o'z ovozini eshitib qoladi
VAD_START_SENSITIVITY=LOW
VAD_END_SENSITIVITY=HIGH
VAD_PREFIX_MS=150
VAD_SILENCE_MS=500
TRANSCRIPTION_LANGUAGES=uz-UZ,ru-RU,en-US
SESSION_RESUMPTION=true
CONTEXT_COMPRESSION=true

# ── Ism bilan chaqirish (wake) ─────────────────────────
WAKE_NAME=Nexus
# name (standart) = faqat ism aytilganda (+ qisqa follow-up oynasi); always = har qanday ovozga
# javob beradi (xonada boshqalar gapirsa chalg'iydi); smart = ism yoki buyruqqa o'xshash qisqa gap
WAKE_MODE=name
# Ism aytilgach shuncha soniya ismsiz gapirish mumkin (bu vaqtda boshqa ovozlarga ham javob beriladi)
WAKE_FOLLOW_UP_S=8
# Suhbat rejimi ("kel gaplashamiz" — ismsiz erkin suhbat): shuncha soniya jimlikdan keyin tugaydi
CONVERSATION_IDLE_S=45

# ── UI ko'prigi (WebSocket) ─────────────────────────────
UI_HOST=127.0.0.1
UI_PORT=8765
SERVE_UI=true

# ── Qayta ulanish ───────────────────────────────────────
RECONNECT_BASE_DELAY=1.0
RECONNECT_MAX_DELAY=30.0

# ── Xavfsizlik ──────────────────────────────────────────
ALLOW_TERMINAL=true
SCREENSHOT_DIR=~/Desktop
LOG_LEVEL=INFO

# ── Video tarjimasi (translate_video: YouTube → o'zbekcha ovoz) ──
# Talab: brew install yt-dlp ffmpeg; Chrome: View → Developer → Allow JavaScript from Apple Events
# Bo'sh = GEMINI_MODEL
VIDEO_TRANSLATE_MODEL=
# prompt (tarjimon system instruction) | native (+ Live translation_config, eksperimental)
VIDEO_TRANSLATE_MODE=prompt
# Parallel tarjimon sessiyalari (5 tavsiya; kam bo'lsa gaplar tushib qoladi, ko'p bo'lsa API kvotasi yetmaydi)
VIDEO_TRANSLATE_SESSIONS=5
